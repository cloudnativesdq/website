# Copy to .env.local (`pnpm run dev:setup` does it for you). Never commit real values.

# Data source: "ocg" (default) or "fallback"
DATA_SOURCE=ocg

# OCG group slug (find it at https://ocgroups.dev/cncf/group/{slug})
OCG_GROUP_SLUG=cqecyjw

# Optional: OCG base URL override
# OCG_BASE_URL=https://ocgroups.dev

# Optional: Resend API key for the contact form. Without it the form returns a configuration error.
# RESEND_API_KEY=

# Optional: Google Cloud key with the Calendar API enabled, for the CNCF New Contributor
# Orientation dates on /resources. Without it the page links to the calendar instead.
# GOOGLE_CALENDAR_API_KEY=

# Optional: Luma events to merge in. Comma-separated URLs, or JSON like
# [{"url":"https://lu.ma/xyz","type":"Meetup"}]. Defaults to links.lumaEvents in src/lib/links.ts.
# LUMA_EVENT_URLS=
